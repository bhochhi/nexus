# Template only: the application never reads .env.example.
# Copy the settings you need to ~/.secrets/dev.env and/or the project .env.
# OpenAI is the configurable default provider.
MODEL_PROVIDER=openai
MODEL_ID=gpt-5.6-luna
MODEL_REASONING_EFFORT=low
OPENAI_API_KEY=

# Keep the deterministic fallback enabled for a credential-free POC demo.
ALLOW_PROVIDER_FALLBACK=true

# Optional local runtime overrides:
# STATE_DB_PATH=data/assistant_state.db
SESSION_TTL_SECONDS=600
# SKILL_CATALOG_PATH=skills/catalog
# AVAILABLE_SKILLS_PATH=skills/available
# KNOWLEDGE_PATH=data/knowledge.json
# CATALOG_POLL_SECONDS=0.5

# Privacy-safe structured tracing. Supported backends: console, langfuse.
# Use console,langfuse to send the same observations to both destinations.
TRACE_BACKENDS=console
# Use pretty for interactive CLI output; use json for log ingestion.
TRACE_CONSOLE_FORMAT=pretty
TRACE_LOG_LEVEL=INFO
TRACE_INCLUDE_CONTENT=false
TRACE_HASH_SESSION_ID=true
TRACE_ENVIRONMENT=local
TRACE_SERVICE_NAME=agentic-member-assistant

# These defaults match observability/docker-compose.langfuse.yml.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-member-assistant-local
LANGFUSE_SECRET_KEY=sk-lf-member-assistant-local
